[tasks]
bmc
cover
prove

[options]
bmc: mode bmc
bmc: depth 10

cover: mode cover
cover: depth 10

prove: mode prove
prove: depth 10

[engines]
bmc:   smtbmc boolector
cover: smtbmc boolector
prove: abc pdr

[script]
read -formal -sv bf16_fma_io.sv bf16_fma_io_formal.sv bf16_loader.sv bf16_outputter.sv
prep -top bf16_fma_io_formal

[files]
bf16_fma_io.sv ../../rtl/bf16_fma_io.sv
bf16_fma_io_formal.sv
bf16_loader.sv ../../rtl/bf16_loader.sv
bf16_outputter.sv ../../rtl/bf16_outputter.sv